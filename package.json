{
  "name": "my-tasks-android",
  "version": "1.0.0",
  "private": true,
  "description": "Личный список дел по локациям",
  "scripts": {
    "build": "node -e \"const fs=require('fs');fs.rmSync('www',{recursive:true,force:true});fs.mkdirSync('www');for(const f of ['index.html','manifest.webmanifest','sw.js'])fs.copyFileSync(f,'www/'+f);\""
  },
  "dependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/core": "^7.4.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.3"
  }
}